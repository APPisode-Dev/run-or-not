default_platform(:ios)

project_root = File.expand_path("..", __dir__)

platform :android do
  desc "Build and upload Android App Bundle to Google Play"
  lane :deploy do
    json_key = ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH")
    package_name = ENV.fetch("ANDROID_PACKAGE_NAME", "com.appisode.run_or_not")
    track = ENV.fetch("ANDROID_TRACK", "internal")
    pubspec_path = File.join(project_root, "pubspec.yaml")
    aab_path = File.join(
      project_root,
      "build/app/outputs/bundle/release/app-release.aab"
    )

    UI.header("Android deployment context")
    UI.message("Lane working directory: #{Dir.pwd}")
    UI.message("Project root: #{project_root}")
    UI.message("pubspec.yaml: #{pubspec_path} (exists: #{File.exist?(pubspec_path)})")
    UI.message("Package: #{package_name}")
    UI.message("Track: #{track}")

    UI.user_error!("pubspec.yaml was not found: #{pubspec_path}") unless File.exist?(pubspec_path)

    pubspec_version_match = File.read(pubspec_path).match(
      /^version:\s*(\d+\.\d+\.\d+)\+(\d+)/
    )
    UI.user_error!("pubspec.yaml version was not found: #{pubspec_path}") unless pubspec_version_match

    pubspec_version = pubspec_version_match[1]
    pubspec_build_number = pubspec_version_match[2].to_i
    UI.message("pubspec version: #{pubspec_version}+#{pubspec_build_number}")

    play_store_version_codes = google_play_track_version_codes(
      json_key: json_key,
      package_name: package_name,
      track: track
    )
    latest_play_store_build_number = play_store_version_codes.max || 0
    next_build_number = [latest_play_store_build_number + 1, pubspec_build_number].max

    UI.message("Google Play version codes: #{play_store_version_codes.sort.join(", ")}")
    UI.message("Latest Google Play build number: #{latest_play_store_build_number}")
    UI.message("Selected Android build: #{pubspec_version}+#{next_build_number}")

    sh("flutter pub get")
    sh(
      "flutter build appbundle " \
      "--release " \
      "--target=lib/app/main.dart " \
      "--build-name=#{pubspec_version} " \
      "--build-number=#{next_build_number}"
    )

    UI.user_error!("Android App Bundle was not generated: #{aab_path}") unless File.exist?(aab_path)
    UI.message("Generated AAB: #{aab_path} (#{File.size(aab_path)} bytes)")

    upload_to_play_store(
      json_key: json_key,
      package_name: package_name,
      aab: aab_path,
      track: track,
      release_status: ENV.fetch("ANDROID_RELEASE_STATUS", "draft"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Build and upload iOS IPA to TestFlight"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    pubspec_path = File.join(project_root, "pubspec.yaml")
    UI.user_error!("pubspec.yaml was not found: #{pubspec_path}") unless File.exist?(pubspec_path)

    pubspec_version = File.read(pubspec_path)[/^version:\s*(\d+\.\d+\.\d+)/, 1]
    UI.user_error!("pubspec.yaml version was not found: #{pubspec_path}") unless pubspec_version

    bundle_id = ENV.fetch("IOS_BUNDLE_ID", "com.appisode.runOrNot")
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: bundle_id,
      version: pubspec_version,
      initial_build_number: 0
    )
    next_build_number = latest_build_number + 1

    UI.message("Building iOS #{pubspec_version} (#{next_build_number})")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/Runner.xcodeproj",
      team_id: ENV.fetch("IOS_TEAM_ID"),
      targets: ["Runner"],
      profile_name: ENV.fetch("IOS_PROVISIONING_PROFILE_NAME"),
      code_sign_identity: "Apple Distribution"
    )

    export_options_path = File.join(project_root, "ios/ExportOptions.ci.plist")
    File.write(export_options_path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>teamID</key>
        <string>#{ENV.fetch("IOS_TEAM_ID")}</string>
        <key>provisioningProfiles</key>
        <dict>
          <key>#{bundle_id}</key>
          <string>#{ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")}</string>
        </dict>
        <key>uploadBitcode</key>
        <false/>
        <key>uploadSymbols</key>
        <true/>
      </dict>
      </plist>
    PLIST

    sh("flutter pub get")
    sh(
      "flutter build ipa " \
      "--release " \
      "--target=lib/app/main.dart " \
      "--build-name=#{pubspec_version} " \
      "--build-number=#{next_build_number} " \
      "--export-options-plist=#{export_options_path}"
    )

    ipa_path = Dir[File.join(project_root, "build/ios/ipa/*.ipa")].first
    UI.user_error!("IPA file was not generated") unless ipa_path

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
